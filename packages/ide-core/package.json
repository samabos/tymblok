{
  "name": "@tymblok/ide-core",
  "version": "0.1.0",
  "description": "IDE-agnostic core logic for Tymblok extensions",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tymblok/shared": "workspace:*",
    "@tymblok/api-client": "workspace:*",
    "axios": "^1.7.9",
    "octokit": "^4.1.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
